# ==============================================================================
# TravelAI Backend Environment Configuration
# ==============================================================================

# LLM Provider Configuration
# Groq supplies chat generation. Optional RAG is configured separately below.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Optional regional-guide retrieval. Basic cloud deployment does not need Ollama.
# Install requirements-rag.txt and ingest guides before enabling.
RAG_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
# Empty keeps the existing Backend/chromadb_storage directory.
# For cloud persistence, set an absolute path on your mounted persistent disk.
CHROMA_PERSIST_DIR=
RAG_TIMEOUT_SECONDS=3
RAG_FAILURE_COOLDOWN_SECONDS=60
RAG_CACHE_TTL_SECONDS=300
RAG_CACHE_SIZE=128
RAG_MAX_CONTEXT_CHARS=6000

# Real-Time Travel Data APIs
# SerpApi is used for live Google Flights, Hotels, and Real-time Search discovery
SERPAPI_API_KEY=your_serpapi_api_key_here

# Database Configuration (MongoDB)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=travel_ai

# Allowed browser origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Local output-token budget; tune to your Groq account's actual quota.
GROQ_OUTPUT_TOKENS_PER_MINUTE=1000

# Dynamic Routing V2. Public demo: run uvicorn with --workers 1.
# Empty URL disables external road lookups and retains labelled distance estimates.
ROUTING_DRIVING_URL=https://router.project-osrm.org
ROUTING_DRIVING_PROFILE=driving
# Configure only with an endpoint actually built for walking; never reuse the car dataset.
ROUTING_WALKING_URL=
ROUTING_WALKING_PROFILE=foot
